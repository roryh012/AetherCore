  "probeSource": "#ifdef PACING_BASELINE\n#include \"FramePacerBaseline.hpp\"\n#else\n#include \"utils/FramePacer.hpp\"\n#endif\n#include <algorithm>\n#include <vector>\n#include <numeric>\n#include <iostream>\n#define WIN32_LEAN_AND_MEAN\n#define NOMINMAX\n#include <Windows.h>\nstatic double CpuSeconds() { FILETIME c,e,k,u; GetProcessTimes(GetCurrentProcess(),&c,&e,&k,&u); ULARGE_INTEGER a,b; a.LowPart=k.dwLowDateTime; a.HighPart=k.dwHighDateTime; b.LowPart=u.dwLowDateTime; b.HighPart=u.dwHighDateTime; return double(a.QuadPart+b.QuadPart)/1e7; }\n#include <cstdlib>\n\nint main(int argc, char** argv) {\n const float fps = argc > 1 ? std::atof(argv[1]) : 60.f;\n aether::FramePacer pacer; pacer.SetTargetFps(fps);\n for(int i=0;i<30;++i) pacer.Wait();\n DWORD handlesBefore=0, handlesAfter=0;\n GetProcessHandleCount(GetCurrentProcess(),&handlesBefore);\n std::vector<double> times;\n auto start=aether::FramePacer::Clock::now(),prev=start;\n const auto cpu=CpuSeconds();\n for(int i=0;i<300;++i) { pacer.Wait(); auto now=aether::FramePacer::Clock::now(); times.push_back(std::chrono::duration<double,std::milli>(now-prev).count()); prev=now; }\n const double wall=std::chrono::duration<double>(prev-start).count();\n const double cpuSeconds=CpuSeconds()-cpu;\n GetProcessHandleCount(GetCurrentProcess(),&handlesAfter);\n if(handlesBefore!=handlesAfter) return 2;\n std::sort(times.begin(),times.end());\n std::cout<<\"{\\\"fps\\\":\"<<fps<<\",\\\"mean_ms\\\":\"<<std::accumulate(times.begin(),times.end(),0.0)/times.size()<<\",\\\"p50_ms\\\":\"<<times[150]<<\",\\\"p95_ms\\\":\"<<times[285]<<\",\\\"p99_ms\\\":\"<<times[297]<<\",\\\"max_ms\\\":\"<<times.back()<<\",\\\"cpu_seconds\\\":\"<<cpuSeconds<<\",\\\"wall_seconds\\\":\"<<wall<<\",\\\"handles_before\\\":\"<<handlesBefore<<\",\\\"handles_after\\\":\"<<handlesAfter<<\"}\\n\";\n}\n",
  "probeCmake": "cmake_minimum_required(VERSION 3.25)\nproject(PacingProbe LANGUAGES CXX)\nadd_executable(pacing_baseline probe.cpp)\ntarget_compile_definitions(pacing_baseline PRIVATE PACING_BASELINE)\ntarget_include_directories(pacing_baseline PRIVATE \"../../src/engine\")\ntarget_compile_features(pacing_baseline PRIVATE cxx_std_23)\nadd_executable(pacing_candidate probe.cpp ../../src/engine/utils/FramePacer.cpp)\ntarget_include_directories(pacing_candidate PRIVATE \"../../src/engine\")\ntarget_compile_features(pacing_candidate PRIVATE cxx_std_23)\n",
